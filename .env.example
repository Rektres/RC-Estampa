# ===========================================================================
# RC Estampa — Configuración de Entorno para Servidor (Multi-Tenant / Aislado)
# ===========================================================================

# Puerto público del frontend en el servidor host.
# Se define 8088 por defecto para NO colisionar con 80 (Nginx), 8080 (Apache/Tomcat),
# 3000 (Node), 5000 (Flask), 5173 (Vite dev) ni 8000 (Django dev).
# Puedes cambiarlo al puerto que tengas libre en tu servidor (ej: 8085, 8090, 9000).
FRONTEND_PORT=8088

# Django Core
DEBUG=False
SECRET_KEY=cambiar-por-un-string-seguro-y-largo-de-al-menos-50-caracteres

# Hosts / Dominios permitidos para Django.
# Con DEBUG=False, incluye aquí la IP pública de tu servidor y/o tu dominio.
# NO incluyas http:// ni puertos aquí.
# Ejemplo: ALLOWED_HOSTS=localhost,127.0.0.1,backend,203.0.113.10,mi-tienda.cl
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Base de Datos PostgreSQL (Red interna de Docker, sin puertos expuestos al host)
POSTGRES_DB=rcestampa
POSTGRES_USER=rcestampa_user
POSTGRES_PASSWORD=genera-un-password-seguro-aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS & CSRF (Orígenes permitidos en el navegador)
# IMPORTANTE: Aquí SÍ se incluye el protocolo (http/https) y el puerto público configurado.
# Si cambias FRONTEND_PORT a 8088 y tu servidor es 203.0.113.10, agrega: http://203.0.113.10:8088
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://localhost:5173,http://localhost

# URL del API consumida por el frontend SPA
# En el contenedor, Nginx redirige internamente /api hacia http://backend:8000
VITE_API_URL=/api

# ===========================================================================
# Mercado Pago Checkout Pro (Credenciales de Integración)
# ===========================================================================
# Obtén tus credenciales en https://www.mercadopago.cl/developers/panel/app
# Para pruebas iniciales utiliza tus credenciales de TEST (TEST-xxxx).
# Para producción utiliza tus credenciales APP_USR (APP_USR-xxxx).
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_WEBHOOK_SECRET=

# URLs base para redirección de Checkout y Notificaciones Webhook
FRONTEND_URL=http://localhost:8088
BACKEND_PUBLIC_URL=http://localhost:8088

# ===========================================================================
# Configuración de Correo Electrónico (Gmail SMTP)
# ===========================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion-gmail
DEFAULT_FROM_EMAIL=RC Estampa <contacto@rcestampa.cl>

# ===========================================================================
# Cloudflare R2 Object Storage (Almacenamiento de Imágenes y Media)
# ===========================================================================
# Activar para almacenar imágenes en Cloudflare R2 en vez del disco local
USE_R2=True
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET_NAME=rc-estampa
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=pub-xxxxxxxxxxxxxx.r2.dev
