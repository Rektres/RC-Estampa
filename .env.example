# Puerto público del sitio (host). El contenedor del frontend siempre escucha
# en el 80 por dentro; esto solo cambia el puerto del host.
#   80   -> http://localhost           (por defecto, PC local)
#   8080 -> http://TU_IP:8080          (servidor con el 80 ya ocupado)
# Evita puertos que los navegadores bloquean (1-19, 21, 22, 25, 110, 143, 6000...).
FRONTEND_PORT=80

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-50-char-string
# Dominios/IPs desde los que se sirve. Con DEBUG=False, si falta el host real
# Django responde 400 Bad Request. El puerto NO se incluye aquí.
#   Servidor: ALLOWED_HOSTS=203.0.113.10,mi-dominio.cl
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres
POSTGRES_DB=rcestampa
POSTGRES_USER=rcestampa
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS / CSRF (orígenes del frontend). Aquí SÍ va esquema y puerto.
# El admin de Django no deja iniciar sesión si falta el origen en CSRF_TRUSTED_ORIGINS.
#   Servidor: http://203.0.113.10:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost

# Frontend build (URL del API que consume el SPA)
# En docker-compose el nginx del frontend proxea /api al backend, así que /api basta.
VITE_API_URL=/api
